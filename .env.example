# Copy to .env at the repository root. Each developer chooses a distinct project
# name and port. Set the same values for every command against that deployment.
COMPOSE_PROJECT_NAME=junction-dev1
STUDIO_PORT=7860
APP_UID=1000
APP_GID=1000
STUDIO_GIT_SHA=17714488fa9c7d098a056da83f7c220cf983957d
# Exact UTC commit timestamp is used for image provenance when building.
STUDIO_GIT_COMMIT_DATE=2026-11-13T18:07:01+02:00

# Optional Linux-only overlays: fill these from the host inventory before use.
# GPU_RENDER_DEVICE=/dev/dri/renderD128
# RENDER_GID=...
# NPU_DEVICE=/dev/accel/accel0
# NPU_GID=...
# CAMERA_DEVICE=/dev/video...
# LEADER_DEVICE=/dev/ttyACM...
# FOLLOWER_DEVICE=/dev/ttyACM...
# VIDEO_GID=...
# DIALOUT_GID=...
